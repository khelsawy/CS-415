# Copy to sec-05/.env, then configure one LLM provider.
LLM_PROVIDER=ollama_local

# Ollama Local
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=qwen3.5:4b

# Ollama on Google Colab through a protected HTTPS tunnel
OLLAMA_COLAB_URL=
OLLAMA_COLAB_MODEL=qwen3.5:4b
OLLAMA_COLAB_USERNAME=
OLLAMA_COLAB_PASSWORD=

# Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# SovereignEG
SOVEREIGN_BASE_URL=https://backend.sovereigneg.com/v1
SOVEREIGN_MODEL=gpt-oss-20b
SOVEREIGN_API_KEY=

# Supabase project URL and backend Secret key (Settings > API Keys)
SUPABASE_URL=
SUPABASE_KEY=
